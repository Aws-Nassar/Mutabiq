# Copy to .env and fill in. Never commit .env.
# .env is already gitignored.

# ---------------------------------------------------------------------------
# LLM providers. Provide at least one; two lets the app fall back when one
# provider is down. Order is taken from config/config.yaml.
# ---------------------------------------------------------------------------

# Google Gemini
GEMINI_API_KEY=

# Groq (fast free tier)
GROQ_API_KEY=

# OpenRouter (optional third fallback)
OPENROUTER_API_KEY=

# Per-request timeout in seconds before a provider is considered unavailable.
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# Corpus fetch (scripts/fetch_corpus.py)
# ---------------------------------------------------------------------------
# Seconds to wait between requests when scraping. Be polite.
FETCH_DELAY_SECONDS=1.5
# Hard ceiling so a bad run cannot hammer the source site.
FETCH_MAX_PAGES=200
